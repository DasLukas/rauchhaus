  "dependencies": {
    "@fontsource-variable/nunito": "5.3.0",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@types/three": "0.187.0",
    "playwright-core": "1.65.1",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
